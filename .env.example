# ==============================================================================
# ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Customer Support Agent & Evaluation Pipeline
# ==============================================================================
# Copy this file to .env and configure your desired settings:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER SELECTION
# Options: "local" | "remote"
# ------------------------------------------------------------------------------
LLM_PROVIDER=local

# ------------------------------------------------------------------------------
# 2. LOCAL LLM SETTINGS (Used when LLM_PROVIDER=local)
# Requires an OpenAI-compatible local server (e.g. Ollama, LM Studio, vLLM)
# ------------------------------------------------------------------------------
# Default Ollama local endpoint
LOCAL_BASE_URL=http://localhost:11434/v1

# Default local model (run `ollama pull llama3:8b`)
LOCAL_MODEL_NAME=llama3:8b

# ------------------------------------------------------------------------------
# 3. REMOTE / CLOUD API SETTINGS (Used when LLM_PROVIDER=remote)
# Works with any OpenAI-compatible API (OpenAI, Groq, Together AI, OpenRouter, etc.)
# ------------------------------------------------------------------------------
# Example for OpenAI:
REMOTE_BASE_URL=https://api.openai.com/v1
REMOTE_API_KEY=your_openai_api_key_here
REMOTE_MODEL_NAME=gpt-4o-mini

# Example for Groq (Ultra low-latency / ~200ms response time):
# REMOTE_BASE_URL=https://api.groq.com/openai/v1
# REMOTE_API_KEY=gsk_your_groq_api_key_here
# REMOTE_MODEL_NAME=llama-3.1-8b-instant

# Example for OpenRouter (Access to any cloud provider):
# REMOTE_BASE_URL=https://openrouter.ai/api/v1
# REMOTE_API_KEY=sk-or-v1-your_openrouter_key
# REMOTE_MODEL_NAME=meta-llama/llama-3.1-8b-instruct
